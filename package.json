{
  "name": "automation",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "tests:headless": "npx playwright test",
    "tests:headed": "npx playwright test --headed",
    "account-test:headed": "npx playwright test tests/uatfade.spec.ts --headed",
    "income-rec-test:headed": "npx playwright test tests/incomeRec.spec.ts --headed",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky install",
    "seed:ci": "SEED_RUN=1 npx playwright test tests/seed.spec.ts --workers=1",
    "seed:local": "SEED_RUN=1 npx playwright test tests/seed.spec.ts --project=chromium --workers=1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-playwright": "^2.2.0",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.2.5",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.29.1"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "otpauth": "^8.0.3"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
